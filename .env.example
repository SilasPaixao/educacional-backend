# Porta interna da API (o Traefik expõe via HTTPS na rota /api)
PORT=5000
NODE_ENV=production

# Banco de dados (usa o Postgres compartilhado que já roda na VPS)
DATABASE_URL=postgresql://postgres:SENHA_DO_POSTGRES@HOST_DO_POSTGRES:5432/matricula_db
# true apenas se o Postgres exigir SSL (ex.: Supabase). Postgres interno na mesma
# rede Docker normalmente deve ficar false (senão: "server does not support SSL connections")
DB_SSL=false

# Envio de e-mail via Brevo (API)
BREVO_API_KEY=xkeysib-sua_brevo_api_key
BREVO_SENDER_EMAIL=nao-responda@serrinha.ba.gov.br
BREVO_SENDER_NAME=Secretaria de Educação de Serrinha

# Armazenamento de documentos (MinIO já existente na VPS, compatível com S3)
S3_ACCESS_KEY=seu_access_key_do_minio
S3_SECRET_KEY=seu_secret_key_do_minio
S3_BUCKET=matricula-documentos
S3_ENDPOINT=http://HOST_DO_MINIO:9000
S3_PUBLIC_BASE_URL=https://minioapi.SEUDOMINIO.com/matricula-documentos
S3_REGION=us-east-1
